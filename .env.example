# ---------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------
# Personal or project access token with the `api` scope.
# Create one at: https://gitlab.com/-/user_settings/personal_access_tokens
# Never commit the real value: this file is the template, `.env` is the secret.
GITLAB_TOKEN=glpat-REPLACE_ME

# ---------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------
# Base URL of the GitLab instance. Change it for self-hosted installations.
GITLAB_URL=https://gitlab.com

# Namespace that owns the epics. Group level commands (epics, group labels,
# group milestones) need it.
GITLAB_GROUP_PATH=your-group/your-subgroup

# Optional. Skips one API lookup when set.
# GITLAB_GROUP_ID=12345678

# Projects the payloads can reference, as `alias=namespace/project`.
# The alias is what you write in the `project` field of a JSON item.
GITLAB_PROJECTS=repo=your-group/your-subgroup/your-project,api=your-group/your-subgroup/another-project

# ---------------------------------------------------------------------
# Defaults applied when a JSON item does not override them
# ---------------------------------------------------------------------
# Labels added to every created issue/epic that declares none.
GITLAB_DEFAULT_LABELS=status::backlog

# Default milestone title, or empty to leave the items untouched.
GITLAB_DEFAULT_MILESTONE=

# Default work item type: issue, task or incident.
GITLAB_DEFAULT_ISSUE_TYPE=issue

# Usernames assigned by default. Comma separated, must be group members.
GITLAB_DEFAULT_ASSIGNEES=

# State used by listing commands by default.
GITLAB_DEFAULT_STATE=opened

# ---------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------
# Directory containing the JSON documents.
GITLAB_DATA_DIR=data

# HTTP timeout in seconds and how many times a transient failure is retried.
GITLAB_TIMEOUT=30
GITLAB_MAX_RETRIES=3

# Set to false only for self-hosted instances with a self signed certificate.
GITLAB_VERIFY_SSL=true

# DEBUG | INFO | WARNING | ERROR
GITLAB_LOG_LEVEL=INFO

# ANSI colors in the logs. Set to false for CI or set NO_COLOR=1 in the shell.
GITLAB_COLOR=true

# When true, every command behaves as if --dry-run was passed.
GITLAB_DRY_RUN=false
